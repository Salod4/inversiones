<div class="page-header">
  <div>
    <h1>Ganancias de vendedores</h1>
    <p class="lead">Totales y detalle de comisiones por venta.</p>
  </div>
</div>

<section class="card">
  <h2>Totales por vendedor</h2>
  <div class="stats-grid">
    <% @totals_by_user.each do |user_id, total| %>
      <% user = @users[user_id] %>
      <div class="stat">
        <div class="label">Vendedor</div>
        <p class="value"><%= user&.name || user&.email || "Vendedor ##{user_id}" %></p>
        <p class="hint">Total comisión</p>
        <p class="value"><%= number_to_currency(total.to_f, unit: "$") %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="card">
  <h2>Detalle de comisiones por venta</h2>
  <div class="responsive-table">
    <table class="table">
      <thead>
        <tr>
          <th>Vendedor</th>
          <th>Venta</th>
          <th>Proveedor</th>
          <th>Fecha</th>
          <th class="numeric">Comisión %</th>
          <th class="numeric">Comisión $</th>
        </tr>
      </thead>
      <tbody>
        <% @sales_users.each do |su| %>
          <tr>
            <td><%= su.user&.name || su.user&.email || "Vendedor" %></td>
            <td><%= su.sale&.code %></td>
            <td><%= su.sale&.supplier&.name %></td>
            <td><%= su.sale&.date %></td>
            <td class="numeric"><%= number_to_percentage(su.effective_commission_pct.to_f * 100, precision: 2) %></td>
            <td class="numeric"><%= number_to_currency(su.commission_amount.to_f, unit: "$") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= pagination_nav(@pagy) %>
</section>
