<style>
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1rem 0;
  }
  .summary-card {
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .summary-card h3 {
    margin: 0 0 4px;
    font-size: 0.95rem;
    color: #334155;
  }
  .summary-card .value {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: #0f172a;
  }
  .summary-card p {
    margin: 4px 0 0;
    color: #475569;
    font-size: 0.9rem;
  }
</style>

<div class="page-header">
  <h1>Resumen del proveedor</h1>
  <p><strong>Fecha del cierre:</strong> <%= @supplier_closing.closing.business_date %></p>
  <p><strong>Proveedor:</strong> <%= [@supplier_closing.supplier&.code, @supplier_closing.supplier&.name].compact.join(" - ") %></p>
</div>

<section>
  <h2>Totales del día</h2>
  <div class="summary-grid">
    <div class="summary-card">
      <h3>Análisis base</h3>
      <p class="value"><%= number_to_percentage(@totals[:analisis_base_pct].to_d * 100, precision: 6, strip_insignificant_zeros: true) %></p>
      <p>Porcentaje base configurado para este proveedor.</p>
    </div>
    <div class="summary-card">
      <h3>Total asignado</h3>
      <p class="value"><%= number_to_currency(@totals[:total_asignado]) %></p>
      <p>Depósitos de clientes relacionados a este proveedor.</p>
    </div>
    <div class="summary-card">
      <h3>RET.COMP total</h3>
      <p class="value"><%= number_to_currency(@totals[:ret_comp_total]) %></p>
      <p>Suma de (depósito bruto - comisión proveedor) en las ventas.</p>
    </div>
    <div class="summary-card">
      <h3>Transferido</h3>
      <p class="value"><%= number_to_currency(@totals[:transferido]) %></p>
      <p>Monto ya enviado mediante transfers.</p>
    </div>
    <div class="summary-card">
      <h3>Saldo pendiente</h3>
      <p class="value"><%= number_to_currency(@totals[:saldo_pendiente]) %></p>
      <p>RET.COMP total menos transfers.</p>
    </div>
  </div>
</section>

<section>
  <h2>Ventas del proveedor</h2>
  <% if @sales.any? %>
    <table>
      <thead>
        <tr>
          <th>Movimiento</th>
          <th>Fecha</th>
          <th>Retorno completo</th>
        </tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= link_to sale.code, sale_path(sale) %></td>
            <td><%= sale.date %></td>
            <td><%= number_to_currency(sale.gross_deposit.to_d - sale.provider_commission.to_d) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Este proveedor no tuvo ventas en este cierre.</p>
  <% end %>
</section>

<section>
  <h2>Transferencias del día</h2>
  <% if @transfers.any? %>
    <table>
      <thead>
        <tr>
          <th>Movimiento</th>
          <th>Fecha</th>
          <th>Cantidad</th>
        </tr>
      </thead>
      <tbody>
        <% @transfers.each do |transfer| %>
          <% from = transfer.entity_label(:from) %>
          <% to = transfer.entity_label(:to) %>
          <% movement = [from.presence, to.presence].compact %>
          <tr>
            <td><%= movement.size <= 1 ? movement.first.to_s : "#{movement[0]} a #{movement[1]}" %></td>
            <td><%= transfer.occurred_at %></td>
            <td><%= number_to_currency(transfer.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No hay transferencias registradas para este día.</p>
  <% end %>
</section>

<div class="button-group">
  <%= link_to "Volver al cierre", closing_path(@supplier_closing.closing), class: "button button-ghost" %>
</div>
