<style>
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1rem 0;
  }
  .summary-card {
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .summary-card h3 {
    margin: 0 0 4px;
    font-size: 0.95rem;
    color: #334155;
  }
  .summary-card .value {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: #0f172a;
  }
  .summary-card p {
    margin: 4px 0 0;
    color: #475569;
    font-size: 0.9rem;
  }
</style>

<div class="page-header">
  <h1>Resumen del proveedor</h1>
  <p><strong>Fecha del cierre:</strong> <%= @supplier_closing.closing.business_date %></p>
  <p><strong>Proveedor:</strong> <%= [@supplier_closing.supplier&.code, @supplier_closing.supplier&.name].compact.join(" - ") %></p>
</div>

<section>
  <h2>Totales del día</h2>
  <div class="summary-grid">
    <div class="summary-card">
      <h3>Análisis base</h3>
      <p class="value"><%= number_to_percentage(@totals[:analisis_base_pct].to_f * 100, precision: 2) %></p>
      <p>Porcentaje base configurado para este proveedor.</p>
    </div>
    <div class="summary-card">
      <h3>Total asignado</h3>
      <p class="value"><%= number_to_currency(@totals[:total_asignado]) %></p>
      <p>Depósitos de clientes relacionados a este proveedor.</p>
    </div>
    <div class="summary-card">
      <h3>RET.COMP total</h3>
      <p class="value"><%= number_to_currency(@totals[:ret_comp_total]) %></p>
      <p>Suma de (depósito bruto - comisión proveedor) en las ventas.</p>
    </div>
    <div class="summary-card">
      <h3>Transferido</h3>
      <p class="value"><%= number_to_currency(@totals[:transferido]) %></p>
      <p>Monto ya enviado mediante transfers.</p>
    </div>
    <div class="summary-card">
      <h3>Saldo pendiente</h3>
      <p class="value"><%= number_to_currency(@totals[:saldo_pendiente]) %></p>
      <p>RET.COMP total menos transfers.</p>
    </div>
  </div>
</section>

<section>
  <h2>Ventas del proveedor</h2>
  <% if @sales.any? %>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Fecha</th>
          <th>Cliente</th>
          <th>Depósito bruto</th>
          <th>Base neta</th>
          <th>Comisión prov.</th>
          <th>SPEI aplicados</th>
          <th>Capital de trabajo</th>
          <th>Saldo cliente</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= link_to sale.code, sale_path(sale) %></td>
            <td><%= sale.date %></td>
            <td><%= [sale.customer&.code, sale.customer&.name].compact.join(" - ") %></td>
            <td><%= number_to_currency(sale.gross_deposit) %></td>
            <td><%= number_to_currency(sale.net_base) %></td>
            <td><%= number_to_currency(sale.provider_commission) %></td>
            <td><%= number_to_currency(sale.total_transfer_applied) %></td>
            <td><%= number_to_currency(sale.working_capital) %></td>
            <td><%= number_to_currency(sale.customer_balance) %></td>
            <td><%= sale.status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Este proveedor no tuvo ventas en este cierre.</p>
  <% end %>
</section>

<section>
  <h2>Transferencias del día</h2>
  <% if @transfers.any? %>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Fecha y hora</th>
          <th>Venta</th>
          <th>Cliente</th>
          <th>Monto</th>
          <th>Método</th>
          <th>De</th>
          <th>Hacia</th>
          <th>Nota</th>
        </tr>
      </thead>
      <tbody>
        <% @transfers.each do |transfer| %>
          <tr>
            <td><%= transfer.code %></td>
            <td><%= transfer.occurred_at %></td>
            <td><%= transfer.sale&.code %></td>
            <td><%= [transfer.customer&.code, transfer.customer&.name].compact.join(" - ") %></td>
            <td><%= number_to_currency(transfer.amount) %></td>
            <td><%= transfer.payment_method %></td>
            <td><%= "#{transfer.from_entity_type} ##{transfer.from_entity_id}" %></td>
            <td><%= "#{transfer.to_entity_type} ##{transfer.to_entity_id}" %></td>
            <td><%= transfer.note %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No hay transferencias registradas para este día.</p>
  <% end %>
</section>

<div class="button-group">
  <%= link_to "Volver al cierre", closing_path(@supplier_closing.closing), class: "button button-ghost" %>
</div>
