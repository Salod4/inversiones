<%= form_with(model: [@closing, @supplier_closing]) do |form| %>
  <% if @supplier_closing.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@supplier_closing.errors.count, "error") %> prevented this supplier closing from being saved:</h2>
      <ul>
        <% @supplier_closing.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :supplier_id, "Supplier" %>
    <%= form.collection_select :supplier_id, @suppliers, :id, :name %>
  </div>

  <div>
    <%= form.label :supplier_credit %>
    <%= form.number_field :supplier_credit, step: 0.01 %>
  </div>

  <div>
    <%= form.label :amount_owed_to_supplier %>
    <%= form.number_field :amount_owed_to_supplier, step: 0.01 %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
