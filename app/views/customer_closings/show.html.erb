<style>
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1rem 0;
  }
  .summary-card {
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .summary-card h3 {
    margin: 0 0 4px;
    font-size: 0.95rem;
    color: #334155;
  }
  .summary-card .value {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: #0f172a;
  }
  .summary-card p {
    margin: 4px 0 0;
    color: #475569;
    font-size: 0.9rem;
  }
</style>

<div class="page-header">
  <h1>Resumen del cliente</h1>
  <p><strong>Fecha del cierre:</strong> <%= @customer_closing.closing.business_date %></p>
  <p><strong>Cliente:</strong> <%= [@customer_closing.customer&.code, @customer_closing.customer&.name].compact.join(" - ") %></p>
</div>

<section>
  <h2>Totales del día</h2>
  <div class="summary-grid">
    <div class="summary-card">
      <h3>Total depositado</h3>
      <p class="value"><%= number_to_currency(@totals[:total_depositado]) %></p>
      <p>Suma de los depósitos brutos.</p>
    </div>
    <div class="summary-card">
      <h3>Total después de %s</h3>
      <p class="value"><%= number_to_currency(@totals[:total_despues_pcts]) %></p>
      <p>Depósito menos comisión de proveedor y vendedores.</p>
    </div>
    <div class="summary-card">
      <h3>Transferencias</h3>
      <p class="value"><%= number_to_currency(@totals[:transferencias]) %></p>
      <p>Total enviado mediante SPEI.</p>
    </div>
    <div class="summary-card">
      <h3>Transfers recibidos (sin venta)</h3>
      <p class="value"><%= number_to_currency(@totals[:transferencias_recibidas]) %></p>
      <p>Pagos directos al cliente que reducen su saldo.</p>
    </div>
    <div class="summary-card">
      <h3>Total cliente</h3>
      <p class="value"><%= number_to_currency(@totals[:total_cliente]) %></p>
      <p>Total después de %s menos las transferencias.</p>
    </div>
  </div>
</section>

<section>
  <h2>Movimientos del cliente</h2>
  <% if @sales.any? %>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Fecha</th>
          <th>Depósito bruto</th>
          <th>Base neta</th>
          <th>Comisión prov.</th>
          <th>Comisión cliente</th>
          <th>SPEI aplicados</th>
          <th>Capital de trabajo</th>
          <th>Saldo cliente</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= link_to sale.code, sale_path(sale) %></td>
            <td><%= sale.date %></td>
            <td><%= number_to_currency(sale.gross_deposit) %></td>
            <td><%= number_to_currency(sale.net_base) %></td>
            <td><%= number_to_currency(sale.provider_commission) %></td>
            <td><%= number_to_currency(sale.customer_fee) %></td>
            <td><%= number_to_currency(sale.total_transfer_applied) %></td>
            <td><%= number_to_currency(sale.working_capital) %></td>
            <td><%= number_to_currency(sale.customer_balance) %></td>
            <td><%= sale.status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Este cliente no tuvo movimientos en este cierre.</p>
  <% end %>
</section>

<div class="button-group">
  <%= link_to "Volver al cierre", closing_path(@customer_closing.closing), class: "button button-ghost" %>
</div>
