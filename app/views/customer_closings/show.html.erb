<h1>Resumen del cliente</h1>

<p><strong>Fecha del cierre:</strong> <%= @customer_closing.closing.business_date %></p>
<p><strong>Cliente:</strong> <%= [@customer_closing.customer&.code, @customer_closing.customer&.name].compact.join(" - ") %></p>

<section>
  <h2>Totales del día</h2>
  <dl class="summary-list">
    <div>
      <dt>Depósito bruto</dt>
      <dd><%= number_to_currency(@totals[:gross_deposit]) %></dd>
    </div>
    <div>
      <dt>Base neta</dt>
      <dd><%= number_to_currency(@totals[:net_base]) %></dd>
    </div>
    <div>
      <dt>Comisión proveedor</dt>
      <dd><%= number_to_currency(@totals[:provider_commission]) %></dd>
    </div>
    <div>
      <dt>Comisión cliente</dt>
      <dd><%= number_to_currency(@totals[:customer_fee]) %></dd>
    </div>
    <div>
      <dt>SPEI aplicados</dt>
      <dd><%= number_to_currency(@totals[:total_transfer_applied]) %></dd>
    </div>
    <div>
      <dt>Capital de trabajo</dt>
      <dd><%= number_to_currency(@totals[:working_capital]) %></dd>
    </div>
    <div>
      <dt>Saldo de cliente (ventas)</dt>
      <dd><%= number_to_currency(@totals[:customer_balance]) %></dd>
    </div>
    <div>
      <dt>Saldo de cliente al cierre</dt>
      <dd><%= number_to_currency(@totals[:customer_balance_at_closing]) %></dd>
    </div>
    <div>
      <dt>Por cobrar al cierre</dt>
      <dd><%= number_to_currency(@totals[:receivables_at_closing]) %></dd>
    </div>
  </dl>
</section>

<section>
  <h2>Movimientos del cliente</h2>
  <% if @sales.any? %>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Fecha</th>
          <th>Proveedor</th>
          <th>Depósito bruto</th>
          <th>Base neta</th>
          <th>Comisión prov.</th>
          <th>Comisión cliente</th>
          <th>SPEI aplicados</th>
          <th>Capital de trabajo</th>
          <th>Saldo cliente</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= link_to sale.code, sale_path(sale) %></td>
            <td><%= sale.date %></td>
            <td><%= [sale.supplier&.code, sale.supplier&.name].compact.join(" - ") %></td>
            <td><%= number_to_currency(sale.gross_deposit) %></td>
            <td><%= number_to_currency(sale.net_base) %></td>
            <td><%= number_to_currency(sale.provider_commission) %></td>
            <td><%= number_to_currency(sale.customer_fee) %></td>
            <td><%= number_to_currency(sale.total_transfer_applied) %></td>
            <td><%= number_to_currency(sale.working_capital) %></td>
            <td><%= number_to_currency(sale.customer_balance) %></td>
            <td><%= sale.status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Este cliente no tuvo movimientos en este cierre.</p>
  <% end %>
</section>

<div class="button-group">
  <%= link_to "Volver al cierre", closing_path(@customer_closing.closing), class: "button button-ghost" %>
</div>
