
<div class="page-header">
  <div>
    <h1>Clientes</h1>
    <p class="lead">Listado de clientes con filtros y relación con proveedores.</p>
  </div>
  <div class="button-group">
    <%= link_to "Nuevo cliente", new_customer_path, class: "button" %>
  </div>
</div>

<div class="card customer-filters">
  <div class="stack stack--row-md stack--between">
    <nav class="cluster" aria-label="Filtrar clientes por saldo">
      <% filters = {
           "positive" => "Con saldo",
           "zero" => "En cero",
           "all" => "Todos"
         } %>
      <% filters.each do |key, label| %>
        <% active = (@balance_filter == key) %>
        <%= link_to label,
                    customers_path(request.query_parameters.merge(balance: key, page: nil)),
                    class: "filter-pill #{active ? 'is-active' : ''}",
                    aria: { current: active ? "page" : nil } %>
      <% end %>
    </nav>

    <%= search_form_for @q, url: customers_path, method: :get, class: "cluster customer-search" do |f| %>
      <%= hidden_field_tag :balance, @balance_filter %>
      <%= f.search_field :name_or_code_cont,
                          value: params.dig(:q, :name_or_code_cont),
                          placeholder: "Buscar cliente o código...",
                          class: "input input-search" %>
      <%= f.submit "Buscar", class: "button hide-desktop" %>
      <%= link_to "Limpiar", customers_path, class: "button button--secondary" %>
    <% end %>
  </div>
</div>

<% if @grouped_customers.any? %>
  <section class="card">
    <h2>Grupos</h2>
    <div class="stats-grid">
      <% @grouped_customers.each do |group| %>
        <div class="stat">
          <div class="label"><%= group[:name] %></div>
          <p class="value"><%= pluralize(group[:count], "cliente") %></p>
          <div class="button-group">
            <%= link_to "Ver grupo", group_customers_path(name: group[:name]), class: "button button-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
    <p class="hint">Los grupos se ocultan de la tabla inferior para no duplicar clientes.</p>
  </section>
<% end %>

<div class="card customers-list">
  <div class="table-subtitle">Listado de clientes</div>
  <div class="responsive-table">
    <table class="table">
      <thead>
        <tr>
          <th><%= sort_link @q, :name, "Cliente" %></th>
          <th>Código</th>
          <th>Saldo final</th>
          <th class="actions-desktop">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @customers.each do |c| %>
          <tr id="<%= dom_id(c) %>">
          <td><%= link_to c.name, c %></td>
          <td><%= c.code %></td>
          <td><%= number_to_currency(@customer_balances[c.id] || 0, unit: "$") %></td>
          <td class="actions-desktop">
            <div class="actions-stack">
              <%= link_to "Ver", c, class: "button button-secondary" %>
              <%= link_to "Editar", edit_customer_path(c), class: "button button-ghost" %>
              <%= link_to "Eliminar", c, class: "button button-danger", data: { turbo_method: :delete, turbo_confirm: "¿Eliminar cliente?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
    </table>
  </div>
</div>

<%= pagination_nav(@pagy) %>
