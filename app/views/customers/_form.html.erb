<div class="card">
  <%= form_with(model: customer) do |form| %>
    <% if customer.errors.any? %>
      <div class="errors">
        <h2><%= pluralize(customer.errors.count, "error") %> prevented this customer from being saved:</h2>
        <ul>
          <% customer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-grid">
      <div class="field">
        <%= form.label :code, "Código" %>
        <%= form.text_field :code %>
      </div>

      <div class="field">
        <%= form.label :name, "Nombre" %>
        <%= form.text_field :name %>
      </div>

      <div class="field">
        <%= form.label :default_customer_fee_pct, "% fee por defecto" %>
        <%= form.number_field :default_customer_fee_pct, step: :any, min: 0 %>
        <p class="hint">Formato decimal: 2% = 0.02, 0.2% = 0.002.</p>
      </div>
    </div>

    <div
      class="card-section"
      data-controller="customer-suppliers"
      data-customer-suppliers-default-vendor-ids-value="<%= (@default_vendor_ids || []).to_json %>"
    >
      <h3 class="section-title">Proveedores y vendedores</h3>
      <p class="hint">Usa formato decimal: 2% = 0.02.</p>

      <div data-customer-suppliers-target="suppliersContainer">
        <%= form.fields_for :customer_suppliers do |cs_fields| %>
          <div class="card-section supplier-block" data-supplier-block>
            <%= cs_fields.hidden_field :id %>
            <div class="form-grid">
              <div class="field">
                <%= cs_fields.label :supplier_id, "Proveedor" %>
                <%= cs_fields.collection_select :supplier_id, @suppliers, :id, :name, include_blank: true %>
              </div>
              <div class="field">
                <%= cs_fields.label :customer_fee_pct, "% fee" %>
                <%= cs_fields.number_field :customer_fee_pct, step: :any, min: 0 %>
              </div>
            </div>

            <div class="vendor-block" data-vendor-container>
              <%= cs_fields.fields_for :customer_supplier_vendors do |csv_fields| %>
                <div class="form-grid" data-vendor-row>
                  <%= csv_fields.hidden_field :id %>
                  <div class="field">
                    <%= csv_fields.label :user_id, "Vendedor" %>
                    <%= csv_fields.collection_select :user_id, @users, :id, :name, include_blank: true %>
                  </div>
                  <div class="field">
                    <%= csv_fields.label :commission_pct, "% comisión" %>
                    <%= csv_fields.number_field :commission_pct, step: :any, min: 0 %>
                  </div>
                </div>
              <% end %>
            </div>

            <button
              type="button"
              class="button button-secondary button-small"
              data-action="customer-suppliers#addVendor"
            >
              Agregar vendedor
            </button>

            <template data-vendor-template>
              <%= cs_fields.fields_for :customer_supplier_vendors, CustomerSupplierVendor.new, child_index: "NEW_VENDOR" do |csv_fields| %>
                <div class="form-grid" data-vendor-row>
                  <div class="field">
                    <%= csv_fields.label :user_id, "Vendedor" %>
                    <%= csv_fields.collection_select :user_id, @users, :id, :name, include_blank: true %>
                  </div>
                  <div class="field">
                    <%= csv_fields.label :commission_pct, "% comisión" %>
                    <%= csv_fields.number_field :commission_pct, step: :any, min: 0 %>
                  </div>
                </div>
              <% end %>
            </template>
          </div>
        <% end %>
      </div>

      <button
        type="button"
        class="button button-secondary button-small"
        data-action="customer-suppliers#addSupplier"
      >
        Agregar proveedor
      </button>

      <template data-customer-suppliers-target="supplierTemplate">
        <%= form.fields_for :customer_suppliers, CustomerSupplier.new, child_index: "NEW_SUPPLIER" do |cs_fields| %>
          <div class="card-section supplier-block" data-supplier-block>
            <div class="form-grid">
              <div class="field">
                <%= cs_fields.label :supplier_id, "Proveedor" %>
                <%= cs_fields.collection_select :supplier_id, @suppliers, :id, :name, include_blank: true %>
              </div>
              <div class="field">
                <%= cs_fields.label :customer_fee_pct, "% fee" %>
                <%= cs_fields.number_field :customer_fee_pct, step: :any, min: 0 %>
              </div>
            </div>

            <div class="vendor-block" data-vendor-container></div>

            <button
              type="button"
              class="button button-secondary button-small"
              data-action="customer-suppliers#addVendor"
            >
              Agregar vendedor
            </button>

            <template data-vendor-template>
              <%= cs_fields.fields_for :customer_supplier_vendors, CustomerSupplierVendor.new, child_index: "NEW_VENDOR" do |csv_fields| %>
                <div class="form-grid" data-vendor-row>
                  <div class="field">
                    <%= csv_fields.label :user_id, "Vendedor" %>
                    <%= csv_fields.collection_select :user_id, @users, :id, :name, include_blank: true %>
                  </div>
                  <div class="field">
                    <%= csv_fields.label :commission_pct, "% comisión" %>
                    <%= csv_fields.number_field :commission_pct, step: :any, min: 0 %>
                  </div>
                </div>
              <% end %>
            </template>
          </div>
        <% end %>
      </template>
    </div>

    <div class="button-group">
      <%= form.submit "Guardar", class: "button" %>
      <%= link_to "Cancelar", customer.persisted? ? customer_path(customer) : customers_path, class: "button button-ghost" %>
    </div>
  <% end %>
</div>
