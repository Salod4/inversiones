<div class="card">
  <%= form_with(model: customer) do |form| %>
    <% if customer.errors.any? %>
      <div class="errors">
        <h2><%= pluralize(customer.errors.count, "error") %> prevented this customer from being saved:</h2>
        <ul>
          <% customer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-grid">
      <div class="field">
        <%= form.label :code, "Código" %>
        <%= form.text_field :code %>
      </div>

      <div class="field">
        <%= form.label :name, "Nombre" %>
        <%= form.text_field :name %>
      </div>

      <div class="field">
        <%= form.label :default_customer_fee_pct, "% fee por defecto" %>
        <%= form.number_field :default_customer_fee_pct, step: :any, min: 0 %>
        <p class="hint">Formato decimal: 2% = 0.02, 0.2% = 0.002.</p>
      </div>
    </div>

    <div class="card-section">
      <h3 class="section-title">Fees por proveedor</h3>
      <p class="hint">Usa formato decimal: 2% = 0.02.</p>
      <div id="customer-suppliers-rows">
        <%= form.fields_for :customer_suppliers do |cs_fields| %>
          <div class="form-grid">
            <div class="field">
              <%= cs_fields.label :supplier_id, "Proveedor" %>
              <%= cs_fields.collection_select :supplier_id, @suppliers, :id, :name, include_blank: true %>
            </div>
            <div class="field">
              <%= cs_fields.label :customer_fee_pct, "% fee" %>
              <%= cs_fields.number_field :customer_fee_pct, step: :any, min: 0 %>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-customer-supplier" class="button button-secondary button-small">Agregar proveedor</button>
    </div>

    <div class="card-section">
      <h3 class="section-title">Comisiones por vendedor</h3>
      <p class="hint">Usa formato decimal: 2% = 0.02.</p>
      <div id="commission-defaults-rows">
        <%= form.fields_for :commission_defaults do |cd_fields| %>
          <div class="form-grid">
            <div class="field">
              <%= cd_fields.label :supplier_id, "Proveedor" %>
              <%= cd_fields.collection_select :supplier_id, @suppliers, :id, :name, include_blank: true %>
            </div>
            <div class="field">
              <%= cd_fields.label :user_id, "Vendedor" %>
              <%= cd_fields.collection_select :user_id, @users, :id, :name, include_blank: true %>
            </div>
            <div class="field">
              <%= cd_fields.label :commission_pct, "% comisión" %>
              <%= cd_fields.number_field :commission_pct, step: :any, min: 0 %>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-commission-default" class="button button-secondary button-small">Agregar vendedor</button>
    </div>

    <template id="customer-supplier-template">
      <%= form.fields_for :customer_suppliers, CustomerSupplier.new, child_index: "NEW_RECORD" do |cs_fields| %>
        <div class="form-grid">
          <div class="field">
            <%= cs_fields.label :supplier_id, "Proveedor" %>
            <%= cs_fields.collection_select :supplier_id, @suppliers, :id, :name, include_blank: true %>
          </div>
          <div class="field">
            <%= cs_fields.label :customer_fee_pct, "% fee" %>
            <%= cs_fields.number_field :customer_fee_pct, step: :any, min: 0 %>
          </div>
        </div>
      <% end %>
    </template>

    <template id="commission-default-template">
      <%= form.fields_for :commission_defaults, CommissionDefault.new, child_index: "NEW_RECORD" do |cd_fields| %>
        <div class="form-grid">
          <div class="field">
            <%= cd_fields.label :supplier_id, "Proveedor" %>
            <%= cd_fields.collection_select :supplier_id, @suppliers, :id, :name, include_blank: true %>
          </div>
          <div class="field">
            <%= cd_fields.label :user_id, "Vendedor" %>
            <%= cd_fields.collection_select :user_id, @users, :id, :name, include_blank: true %>
          </div>
          <div class="field">
            <%= cd_fields.label :commission_pct, "% comisión" %>
            <%= cd_fields.number_field :commission_pct, step: :any, min: 0 %>
          </div>
        </div>
      <% end %>
    </template>

    <div class="button-group">
      <%= form.submit "Guardar", class: "button" %>
      <%= link_to "Cancelar", customer.persisted? ? customer_path(customer) : customers_path, class: "button button-ghost" %>
    </div>
  <% end %>
</div>
