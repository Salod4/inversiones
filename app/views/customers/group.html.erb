<h1>Grupo <%= @group[:name] %></h1>
<p><%= pluralize(number_with_delimiter(@display_customers.size), "cliente") %> incluidos<% if @group_search_query.present? %> (filtro: "<%= @group_search_query %>")<% end %>:</p>

<div class="filters">
  <%= form_with url: group_customers_path(name: @group[:name]), method: :get, local: true do %>
    <div class="filter-row">
      <div>
        <label for="q">Buscar cliente</label>
        <input type="text" name="q" id="q" value="<%= @group_search_query %>" placeholder="Nombre contiene" />
      </div>
      <div style="align-self:end">
        <button type="submit" class="button">Filtrar</button>
        <%= link_to "Limpiar", group_customers_path(name: @group[:name]), class: "button button--secondary" %>
      </div>
    </div>
  <% end %>
</div>

<section class="card customer-summary">
  <div class="customer-summary__stat">
    <p class="label">Total depositado</p>
    <p class="stat"><%= number_to_currency(@group_total_deposit || 0, unit: "$") %></p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Total después de %s</p>
    <p class="stat"><%= number_to_currency(@group_total_after_pcts || 0, unit: "$") %></p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Saldo inicial (grupo)</p>
    <p class="stat"><%= number_to_currency(@group_opening_balance || 0, unit: "$") %></p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Transferido a proveedores</p>
    <p class="stat"><%= number_to_currency(@group_total_transferred || 0, unit: "$") %></p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Transfers recibidos </p>
    <p class="stat"><%= number_to_currency(@group_total_received || 0, unit: "$") %></p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Total cliente</p>
    <p class="stat"><%= number_to_currency(@group_available_balance || 0, unit: "$") %></p>
  </div>
</section>

<section class="card">
  <h2>Clientes del grupo</h2>
  <div class="responsive-table">
    <table class="table">
      <thead>
        <tr>
          <th>Cliente</th>
          <th>Código</th>
          <th>Total depositado</th>
          <th>Total después de %s</th>
          <th>Transferido</th>
          <th>Transfers recibidos</th>
          <th>Saldo disponible</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @display_customers.each do |c| %>
          <tr id="<%= dom_id(c) %>">
          <td><%= link_to c.name, c %></td>
          <td><%= link_to c.code, c %></td>
            <td><%= number_to_currency(@per_customer_deposit[c.id].to_f, unit: "$") %></td>
            <td><%= number_to_currency(@per_customer_after_pcts[c.id].to_f, unit: "$") %></td>
            <td><%= number_to_currency(@per_customer_transfers[c.id].to_f, unit: "$") %></td>
            <td><%= number_to_currency(@per_customer_direct_received[c.id].to_f, unit: "$") %></td>
            <td><%= number_to_currency(@per_customer_balances[c.id].to_f, unit: "$") %></td>
            <td><%= link_to "Agregar transfer", new_customer_transfer_path(c), class: "button button--small" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="card">
  <h2>Transfers del grupo</h2>
  <% if @group_transfers.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Código</th>
          <th>Origen</th>
          <th>Destino</th>
          <th>Monto</th>
          <th>Venta</th>
          <th>Nota</th>
        </tr>
      </thead>
      <tbody>
        <% @group_transfers.each do |t| %>
          <% labels = @group_transfer_labels[t] || {} %>
          <tr id="<%= dom_id(t) %>">
            <td><%= l(t.occurred_at, format: :short) %></td>
            <td><%= t.code %></td>
            <td><%= labels[:from] %></td>
            <td><%= labels[:to] %></td>
            <td><%= number_to_currency(t.amount, unit: "$") %></td>
            <td><%= link_to t.sale&.code, t.sale if t.sale.present? %></td>
            <td><%= t.note %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No hay transfers para este grupo.</p>
  <% end %>
</section>

<section class="card">
  <h2>Ventas recientes del grupo</h2>
  <% if @sales.any? %>
    <div class="responsive-table">
      <table class="table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Proveedor</th>
            <th>Bruto (gross_deposit)</th>
            <th>Comisión prov.</th>
            <th>Fee cliente</th>
            <th>Saldo cliente</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @sales.each do |s| %>
            <tr id="<%= dom_id(s) %>">
              <td><%= l(s.date) %></td>
              <td><%= s.customer&.name %></td>
              <td><%= s.supplier&.name %></td>
              <td><%= number_to_currency(s.gross_deposit || 0, unit: "$") %></td>
              <td><%= number_to_currency(s.provider_commission || 0, unit: "$") %></td>
              <td><%= number_to_currency(s.customer_fee || 0, unit: "$") %></td>
              <td><%= number_to_currency(s.customer_balance || 0, unit: "$") %></td>
              <td><%= s.status %></td>
              <td><%= link_to "Ver venta", s %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No hay ventas recientes para este grupo.</p>
  <% end %>
</section>

<p><%= link_to "Volver a clientes", customers_path %></p>
