<h1><%= @customer.name %></h1>
<p>Código: <strong><%= @customer.code %></strong></p>

<section class="card customer-summary">
  <div class="customer-summary__stat">
    <p class="label">Total depositado</p>
    <p class="stat"><%= number_to_currency(@customer_total_deposit || 0, unit: "$") %></p>
    <p class="hint">Suma de los depósitos brutos.</p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Total después de %s</p>
    <p class="stat"><%= number_to_currency(@customer_total_after_pcts || 0, unit: "$") %></p>
    <p class="hint">Depósito menos comisión de proveedor y vendedores.</p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Saldo inicial</p>
    <p class="stat"><%= number_to_currency(@customer_opening_balance || 0, unit: "$") %></p>
    <p class="hint">Saldo de arranque cargado por kickoff.</p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Transferencias</p>
    <p class="stat"><%= number_to_currency(@customer_total_transferred || 0, unit: "$") %></p>
    <p class="hint">Total enviado mediante SPEI.</p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Transfers recibidos (sin venta)</p>
    <p class="stat"><%= number_to_currency(@customer_direct_received || 0, unit: "$") %></p>
    <p class="hint">Pagos directos al cliente que reducen su saldo.</p>
  </div>

  <div class="customer-summary__stat">
    <p class="label">Total cliente</p>
    <p class="stat"><%= number_to_currency(@customer_available_balance || 0, unit: "$") %></p>
    <p class="hint">Total después de %s menos las transferencias.</p>
  </div>

  <div class="customer-summary__actions">
    <% if @sales.any? %>
      <%= link_to "Agregar transfer", new_customer_transfer_path(@customer), class: "button" %>
      <p class="hint">Selecciona la venta destino en el siguiente paso.</p>
    <% else %>
      <p class="hint">Aún no hay ventas para registrar transfers.</p>
    <% end %>
  </div>
</section>

<section class="card">
  <h2>Proveedores</h2>
  <% if @suppliers.any? %>
    <ul class="list">
      <% @suppliers.each do |s| %>
        <li><%= link_to s.name, s %> (<%= s.code %>)</li>
      <% end %>
    </ul>
  <% else %>
    <p>Sin proveedores vinculados.</p>
  <% end %>
</section>

<section class="card">
  <h2>Ventas recientes</h2>
  <% if @sales.any? %>
    <div class="responsive-table">
      <table class="table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Código venta</th>
            <th>Proveedor</th>
            <th>Bruto (gross_deposit)</th>
            <th>Comisión prov.</th>
            <th>Fee cliente</th>
            <th>Saldo cliente</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @sales.each do |s| %>
            <tr id="<%= dom_id(s) %>">
              <td><%= l(s.date) %></td>
              <td><%= s.code %></td>
              <td><%= s.supplier&.name %></td>
              <td><%= number_to_currency(s.gross_deposit || 0, unit: "$") %></td>
              <td><%= number_to_currency(s.provider_commission || 0, unit: "$") %></td>
              <td><%= number_to_currency(s.customer_fee || 0, unit: "$") %></td>
              <td><%= number_to_currency(s.customer_balance || 0, unit: "$") %></td>
              <td><%= s.status %></td>
              <td><%= link_to "Ver venta", s %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No hay ventas recientes.</p>
  <% end %>
</section>

<section class="card" id="customer-transfers">
  <h2>Transfers del cliente</h2>
  <% if @customer_transfers.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Código</th>
          <th>Venta</th>
          <th>Proveedor</th>
          <th>Tipo</th>
          <th>Monto</th>
          <th>Nota</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @customer_transfers.each do |transfer| %>
          <tr id="<%= dom_id(transfer) %>">
            <td><%= l(transfer.occurred_at, format: :short) %></td>
            <td><%= transfer.code %></td>
            <td><%= link_to transfer.sale&.code, transfer.sale if transfer.sale.present? %></td>
            <td><%= transfer.supplier&.name %></td>
            <td><%= [transfer.from_entity_type, "→", transfer.to_entity_type].compact.join(" ") %></td>
            <td><%= number_to_currency(transfer.amount, unit: "$") %></td>
            <td><%= transfer.note.presence || "—" %></td>
            <td><%= link_to "Ver", transfer_path(transfer), class: "button button-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Este cliente aún no tiene transfers registrados.</p>
  <% end %>
</section>
