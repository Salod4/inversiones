<% form_url = local_assigns[:form_url] ||
              if transfer.persisted?
                transfer_path(transfer)
              else
                sale ? sale_transfers_path(sale) : transfers_path
              end %>

<div class="transfer-form-card" data-transfer-form="true" data-cash-box-balance="<%= @cash_box_balance.to_f %>">
  <%= form_with(model: transfer, url: form_url) do |form| %>
    <% if transfer.errors.any? %>
      <div class="errors">
        <h2><%= pluralize(transfer.errors.count, "error") %> prevented this transfer from being saved:</h2>
        <ul>
          <% transfer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-grid">
      <% if transfer.persisted? %>
        <div class="field">
          <%= form.label :code %>
          <%= form.text_field :code %>
        </div>

        <div class="field">
          <%= form.label :occurred_at %>
          <%= form.datetime_field :occurred_at %>
        </div>
      <% else %>
      <div class="field">
        <%= form.label :payment_method, "Tipo de transferencia" %>
        <%= form.select :payment_method,
                        options_for_select([["Depósito", "deposito"], ["Efectivo", "efectivo"]], transfer.payment_method || "deposito"),
                        {},
                        class: "select" %>
        <p class="hint">Depósito usa el código SPEI actual; Efectivo genera código EFE-ORIG-DEST-fecha.</p>
      </div>
      <div class="field">
        <%= form.label :to_cash_box, "Enviar a caja" %>
        <%= form.check_box :to_cash_box, { data: { cash_box_toggle: true } }, "true", "false" %>
        <p class="hint">Si se marca, el monto irá a caja (efectivo interno) y se descontará del saldo del origen.</p>
      </div>
      <div class="field">
        <p class="hint" style="margin-top: 1.8rem;">El código SPEI y la fecha se generarán automáticamente al guardar.</p>
      </div>
    <% end %>
    </div>

    <% if local_assigns[:include_sale_field] && sale.present? %>
      <%= form.hidden_field :sale_id, value: sale&.id %>
    <% end %>
    <%= form.hidden_field :cash_box_amount, value: (transfer.cash_box_amount || 0), data: { cash_box_input: true } %>

<%
  grouped_options = {}
  customer_groups = (defined?(@customer_groups) && @customer_groups.any?) ? @customer_groups : []
  if customer_groups.any?
    grouped_options["Grupos"] = customer_groups.flat_map do |group|
      group_option = [
        "Grupo #{group[:name]} (#{group[:count]})",
        "CustomerGroup:#{group[:name]}",
        {
          "data-entity-type": "CustomerGroup",
          "data-group": group[:name],
          "data-balance": group[:balance].to_f
        }
      ]
      customer_options = group[:customers].map do |c|
        [
          "#{c.name} (#{group[:name]})",
          "Customer:#{c.id}",
          {
            "data-entity-type": "Customer",
            "data-balance": c.available_transfer_total(excluding: transfer).to_f,
            "data-group": group[:name]
          }
        ]
      end
      [ group_option ] + customer_options
    end
  end

  ungrouped_customers = defined?(@ungrouped_customers) ? @ungrouped_customers : []
  if ungrouped_customers.any?
    grouped_options["Clientes sin grupo"] = ungrouped_customers.map do |c|
      [
        c.name,
        "Customer:#{c.id}",
        {
          "data-entity-type": "Customer",
          "data-balance": c.available_transfer_total(excluding: transfer).to_f,
          "data-group": "Clientes sin grupo"
        }
      ]
    end
  end

  suppliers = defined?(@suppliers) ? @suppliers : []
  grouped_options["Proveedores"] = suppliers.map do |s|
    [
      s.name,
      "Supplier:#{s.id}",
      { "data-entity-type": "Supplier", "data-balance": (@supplier_balances && @supplier_balances[s.id]) || "", "data-group": "Proveedores" }
    ]
  end

  users = defined?(@users) ? @users : []
  grouped_options["Vendedores"] = users.map do |u|
    [
      u.name || u.email,
      "User:#{u.id}",
      { "data-entity-type": "User", "data-balance": (@user_balances && @user_balances[u.id]) || "", "data-group": "Vendedores" }
    ]
  end
%>

<% if transfer.from_entity_type == "CustomerGroup" %>
  <% from_selected = "CustomerGroup:#{transfer.from_group}" if transfer.from_group.present? %>
<% elsif transfer.from_entity_type && transfer.from_entity_id %>
  <% from_selected = "#{transfer.from_entity_type}:#{transfer.from_entity_id}" %>
<% end %>
<% destination_entries = local_assigns[:destination_entries] || @destination_entries || [] %>
<% initial_destinations_json = destination_entries.map { |d| { to_entity_ref: d[:to_entity_ref], amount: d[:amount].present? ? d[:amount].to_f : nil } }.to_json %>
<% sale_available = sale.present? ? sale.available_transfer_amount(excluding: transfer) : nil %>
<% allow_multiple_destinations = local_assigns.key?(:allow_multiple_destinations) ? local_assigns[:allow_multiple_destinations] : !transfer.persisted? %>

    <div class="entity-filter">
      <label for="customer_filter" class="hint">Filtrar clientes (como en la tabla de clientes)</label>
      <input id="customer_filter" type="text" placeholder="Nombre o código" />
    </div>

    <div class="entity-picker">
      <label>Origen</label>
      <div class="entity-picker__row">
        <select id="from_type" class="select">
          <option value="">Selecciona tipo</option>
          <option value="Customer">Cliente</option>
          <option value="Supplier">Proveedor</option>
          <option value="User">Vendedor</option>
          <option value="CashBox">Caja (interno)</option>
          <option value="Other">Otro</option>
        </select>
        <select id="from_entity_ref" name="transfer[from_entity_ref]" class="select entity-options">
          <option value="">Selecciona origen</option>
          <option value="Other" <%= "selected" if from_selected == "Other" %>>Otro</option>
          <%= grouped_options_for_select(grouped_options, from_selected) %>
        </select>
      </div>
      <p class="hint" id="from_balance_hint"></p>
    </div>
    <div class="field" data-from-other-field hidden>
      <label>Entregó (otro)</label>
      <input type="text"
             name="transfer[from_other_name]"
             value="<%= transfer.from_other_name.to_s %>"
             data-from-other-input
             placeholder="Nombre de la persona" />
      <p class="hint">Solo información; no crea un registro nuevo.</p>
    </div>

    <div class="origin-balance">
      <p class="hint">
        Saldo del origen:
        <strong id="origin_balance_value" data-sale-available="<%= sale_available&.to_f %>">
          <%= sale_available ? number_to_currency(sale_available, unit: "$") : "—" %>
        </strong>
        · Restante: <strong id="origin_remaining_value">—</strong>
      </p>
    </div>

    <div class="destinations-block"
         id="destinations_block"
         data-sale-available="<%= sale_available&.to_f %>"
         data-initial-destinations="<%= j(initial_destinations_json) %>"
         data-allow-multiple="<%= allow_multiple_destinations %>">
      <div class="destinations-block__header">
        <label>Destinos</label>
        <button type="button" id="add_destination" class="button button-secondary button-small">Agregar destino</button>
      </div>
      <p class="hint">Agrega uno o varios destinos y define cuánto enviar a cada uno. El saldo restante se actualiza en vivo.</p>
      <div id="destination_list"></div>
    </div>

    <template id="destination_row_template">
      <div class="destination-row" data-index="__INDEX__">
        <div class="entity-picker">
          <label>Destino</label>
          <div class="entity-picker__row">
          <select class="select destination-type" data-role="destination-type">
            <option value="">Selecciona tipo</option>
            <option value="Customer">Cliente</option>
            <option value="Supplier">Proveedor</option>
            <option value="User">Vendedor</option>
            <option value="CashBox">Caja (interno)</option>
          </select>
          <select name="transfer[destination_entries][__INDEX__][to_entity_ref]"
                  class="select entity-options"
                  data-role="destination-entity">
            <option value="">Selecciona destino</option>
              <option value="CashBox:internal"
                      data-entity-type="CashBox"
                      data-balance="<%= @cash_box_balance.to_f %>"
                      data-group="Caja">Caja (interno)</option>
              <%= grouped_options_for_select(grouped_options) %>
            </select>
          </div>
          <p class="hint" data-role="destination-balance"></p>
        </div>
        <div>
          <label>Monto</label>
          <input type="number"
                 step="any"
                 name="transfer[destination_entries][__INDEX__][amount]"
                 data-role="destination-amount" />
        </div>
        <div class="destination-row__actions">
          <button type="button" class="button button-ghost remove-destination">Quitar destino</button>
        </div>
      </div>
    </template>

    <% if sale.present? %>
      <p class="hint">
        Balance del cliente en esta venta: <strong><%= number_to_currency(sale.customer_balance.to_f, unit: "$") %></strong><br>
        Disponible para SPEI en esta venta: <strong><%= number_to_currency(sale.available_transfer_amount(excluding: transfer), unit: "$") %></strong>
      </p>
    <% elsif transfer.customer.present? %>
      <% available_total = local_assigns[:customer_balance] || transfer.customer.available_transfer_total(excluding: transfer) %>
      <p class="hint">
        Saldo de cliente: <strong><%= number_to_currency(available_total, unit: "$") %></strong>
      </p>
    <% end %>

    <div>
      <%= form.label :note %>
      <%= form.text_area :note %>
    </div>

    <div class="transfer-actions">
      <%= form.submit "Guardar", class: "button" %>
      <%= link_to "Cancelar", transfer.persisted? ? transfer_path(transfer) : (sale ? sale_transfers_path(sale) : transfers_path), class: "button button-ghost" %>
    </div>
  <% end %>
</div>

<script>
  (() => {
    let destinationBlock;
    let fromSelect;
    let cashBoxBalance = "";

    function formatCurrency(value) {
      if (value === null || Number.isNaN(value)) return "—";
      return new Intl.NumberFormat("es-MX", { style: "currency", currency: "MXN" }).format(Number(value));
    }

    function setupEntitySelector({ typeSelect, entitySelect, balanceHint, customerFilter, selectedValue, onChange, allowOther }) {
      if (!typeSelect || !entitySelect) return;
      const allowOtherType = allowOther === true;

      const baseOptions = Array.from(entitySelect.options)
        .filter((opt) => opt.value)
        .map((opt) => {
          const rawValue = opt.value || "";
          const valueType = rawValue.split(":")[0] || "";
          const balanceAttr = opt.dataset.balance;
          const balanceLabel = balanceAttr && balanceAttr.length > 0 ? ` (${formatCurrency(balanceAttr)})` : "";
          return {
            value: rawValue,
            text: (opt.textContent || "") + balanceLabel,
            entityType: opt.dataset.entityType || valueType,
            balance: opt.dataset.balance,
            group: opt.dataset.group || ""
          };
        });
      const cashBalanceLabel = cashBoxBalance && `${cashBoxBalance}`.length > 0 ? ` (${formatCurrency(cashBoxBalance)})` : "";
      if (!baseOptions.some((opt) => opt.value === "CashBox:internal")) {
        baseOptions.push({
          value: "CashBox:internal",
          text: `Caja (interno)${cashBalanceLabel}`,
          entityType: "CashBox",
          balance: cashBoxBalance,
          group: "Caja"
        });
      }
      if (allowOtherType && !baseOptions.some((opt) => opt.value === "Other")) {
        baseOptions.push({
          value: "Other",
          text: "Otro",
          entityType: "Other",
          balance: "",
          group: ""
        });
      }
      let currentSelected = selectedValue || entitySelect.dataset.selected || entitySelect.value || "";
      const preselected = currentSelected
        ? baseOptions.find((opt) => opt.value === currentSelected)
        : undefined;

      function buildOption(opt) {
        const clone = document.createElement("option");
        clone.value = opt.value;
        clone.textContent = opt.text;
        clone.dataset.entityType = opt.entityType || "";
        clone.dataset.balance = opt.balance || "";
        clone.dataset.group = opt.group || "";
        return clone;
      }

      function updateHint() {
        const selected = entitySelect.selectedOptions[0];
        if (!selected || !selected.dataset) {
          if (balanceHint) balanceHint.textContent = "";
          return;
        }
        const balance = selected.dataset.balance;
        if (balanceHint && balance && balance.length > 0) {
          balanceHint.textContent = `Saldo disponible: ${formatCurrency(Number(balance))}`;
        } else if (balanceHint) {
          balanceHint.textContent = "";
        }
        onChange?.();
      }

      function filterOptions() {
        const type = typeSelect.value;
        const term = (customerFilter?.value || "").trim().toLowerCase();
        const targetValue = entitySelect.value || currentSelected;
        const selectedOpt = targetValue ? baseOptions.find((opt) => opt.value === targetValue) || preselected : preselected;

        entitySelect.innerHTML = "";
        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = "Selecciona";
        entitySelect.appendChild(placeholder);

        const matches = baseOptions.filter((opt) => {
          if (opt.entityType === "Other") {
            return type === "Other";
          }
          const matchesType =
            !type ||
            opt.entityType === type ||
            (type === "Customer" && opt.entityType === "CustomerGroup") ||
            (type === "CashBox" && opt.entityType === "CashBox");
          if (!matchesType) return false;
          if (!term) return true;
          if (type && type !== "Customer") return true; // filtro solo aplicado para clientes
          const labelText = opt.text.toLowerCase();
          const groupText = (opt.group || "").toLowerCase();
          return labelText.includes(term) || groupText.includes(term);
        });

        const selectedIsCompatible = selectedOpt && (!type || selectedOpt.entityType === type || (type === "Customer" && selectedOpt.entityType === "CustomerGroup"));
        if (selectedOpt && selectedIsCompatible && !matches.some((opt) => opt.value === selectedOpt.value)) {
          matches.unshift(selectedOpt);
        }

        matches.forEach((opt) => {
          const option = buildOption(opt);
          if (selectedOpt && selectedOpt.value === opt.value) option.selected = true;
          entitySelect.appendChild(option);
        });

        if (!entitySelect.selectedIndex && entitySelect.options.length === 1) {
          const noResults = document.createElement("option");
          noResults.value = "";
          noResults.textContent = "Sin resultados";
          noResults.disabled = true;
          entitySelect.appendChild(noResults);
        }
        updateHint();
      }

      if (preselected && !typeSelect.value && preselected.entityType) {
        typeSelect.value = preselected.entityType === "CustomerGroup" ? "Customer" : preselected.entityType;
      }

      typeSelect.addEventListener("change", () => {
        if (typeSelect.value === "Customer" && customerFilter) customerFilter.value = "";
        filterOptions();
      });
      entitySelect.addEventListener("change", () => {
        currentSelected = entitySelect.value;
        updateHint();
      });
      customerFilter?.addEventListener("input", filterOptions);

      filterOptions();
    }

    function computeBaseBalance() {
      const saleAvailable = destinationBlock?.dataset.saleAvailable;
      if (saleAvailable && saleAvailable.length > 0 && !Number.isNaN(Number(saleAvailable))) {
        return Number(saleAvailable);
      }
      const selected = fromSelect?.selectedOptions?.[0];
      const balance = selected?.dataset.balance;
      if (balance && balance.length > 0 && !Number.isNaN(Number(balance))) {
        return Number(balance);
      }
      return null;
    }

    function updateRemainingBalance() {
      const base = computeBaseBalance();
      const balanceEl = document.getElementById("origin_balance_value");
      const remainingEl = document.getElementById("origin_remaining_value");
      const amountInputs = Array.from(document.querySelectorAll("[data-role='destination-amount']"));
      const cashBoxInput = document.querySelector("[data-cash-box-input]");
      const toCashBox = document.querySelector("[data-cash-box-toggle]");
      const destinationSelects = Array.from(document.querySelectorAll("[data-role='destination-entity']"));
      const destinationTypes = Array.from(document.querySelectorAll("[data-role='destination-type']"));
      const addBtn = document.getElementById("add_destination");

      let totalDestinations = amountInputs.reduce((sum, input) => {
        const val = Number(input.value || 0);
        return Number.isNaN(val) ? sum : sum + val;
      }, 0);

      if (toCashBox?.checked) {
        // For cash box, force single destination and set its type/ref to caja
        if (amountInputs.length > 1) {
          const firstAmount = amountInputs[0];
          amountInputs.slice(1).forEach((node) => node.closest(".destination-row")?.remove());
          amountInputs.length = 1;
          totalDestinations = Number(firstAmount.value || 0);
        }
        const firstDest = destinationSelects[0];
        const firstType = destinationTypes[0];
        if (firstType) {
          firstType.value = "CashBox";
          firstType.disabled = true;
          firstType.dispatchEvent(new Event("change"));
        }
        if (firstDest) firstDest.value = "CashBox:internal";
        destinationTypes.slice(1).forEach((sel) => (sel.disabled = true));
        if (addBtn) addBtn.disabled = true;
        if (cashBoxInput) cashBoxInput.value = totalDestinations;
      } else {
        destinationTypes.forEach((sel) => (sel.disabled = false));
        if (addBtn) addBtn.disabled = false;
        if (cashBoxInput) cashBoxInput.value = 0;
      }

      const cashBoxAmount = Number(cashBoxInput?.value || 0);
      const total = toCashBox?.checked ? cashBoxAmount : totalDestinations + cashBoxAmount;

      if (balanceEl) balanceEl.textContent = base === null ? "—" : formatCurrency(base);
      if (remainingEl) {
        const remaining = base === null ? null : (base - total);
        remainingEl.textContent = remaining === null ? "—" : formatCurrency(remaining);
        remainingEl.classList.toggle("negative", remaining !== null && remaining < 0);
      }

      // Update each destination hint with saldo/restante
      const rows = Array.from(document.querySelectorAll(".destination-row"));
      rows.forEach((row) => {
        const balanceHint = row.querySelector("[data-role='destination-balance']");
        const entitySelect = row.querySelector("[data-role='destination-entity']");
        const amountInput = row.querySelector("[data-role='destination-amount']");
        updateDestinationHint(balanceHint, entitySelect, amountInput);
      });
    }

    function normalizedEntityType(option) {
      const rawType = option?.dataset?.entityType || (option?.value || "").split(":")[0] || "";
      if (rawType === "CustomerGroup") return "Customer";
      return rawType;
    }

    function computeDestinationRemaining(balance, amount, fromType, destType) {
      if (destType === "CashBox" || destType === "User") {
        return balance + amount;
      }
      if (destType === "Supplier") {
        return balance - amount;
      }
      if (destType === "Customer") {
        return fromType === "Customer" ? balance + amount : balance - amount;
      }
      return balance - amount;
    }

    function updateDestinationHint(balanceHint, entitySelect, amountInput) {
      if (!balanceHint || !entitySelect) return;
      const selected = entitySelect.selectedOptions[0];
      const rawBalance = selected?.dataset?.balance;
      const parsedBalance = Number(rawBalance);
      const hasBalance = rawBalance !== undefined && rawBalance !== null && `${rawBalance}`.trim().length > 0 && !Number.isNaN(parsedBalance);
      const amount = Number(amountInput?.value || 0);
      const amt = Number.isNaN(amount) ? 0 : amount;

      const fromSelected = fromSelect?.selectedOptions?.[0];
      const fromType = normalizedEntityType(fromSelected);
      const destType = normalizedEntityType(selected);

      if (!hasBalance) {
        balanceHint.textContent = "Saldo: — · Restante: —";
        balanceHint.classList.remove("negative");
        return;
      }

      const balance = parsedBalance;
      const remaining = computeDestinationRemaining(balance, amt, fromType, destType);
      balanceHint.textContent = `Saldo: ${formatCurrency(balance)} · Restante: ${formatCurrency(remaining)}`;
      balanceHint.classList.toggle("negative", remaining < 0);
    }

    function initDestinations(customerFilter) {
      destinationBlock = document.getElementById("destinations_block");
      const list = document.getElementById("destination_list");
      const template = document.getElementById("destination_row_template");
      const addBtn = document.getElementById("add_destination");
      if (!destinationBlock || !list || !template) return;

      const allowMultiple = destinationBlock.dataset.allowMultiple === "true";
      if (!allowMultiple && addBtn) addBtn.style.display = "none";

      let nextIndex = 0;
      let initialEntries = [];
      try {
        initialEntries = JSON.parse(destinationBlock.dataset.initialDestinations || "[]");
      } catch (e) {
        initialEntries = [];
      }
      if (!Array.isArray(initialEntries) || initialEntries.length === 0) {
        initialEntries = [ {} ];
      }

      initialEntries.forEach((entry) => addRow(entry));
      addBtn?.addEventListener("click", () => addRow({}));

      function addRow(entry) {
        if (!allowMultiple && list.children.length >= 1) return;
        const node = document.createElement("div");
        node.innerHTML = template.innerHTML.replace(/__INDEX__/g, nextIndex);
        const row = node.firstElementChild;
        if (!row) return;

        const typeSelect = row.querySelector("[data-role='destination-type']");
        const entitySelect = row.querySelector("[data-role='destination-entity']");
        const balanceHint = row.querySelector("[data-role='destination-balance']");
        const amountInput = row.querySelector("[data-role='destination-amount']");
        const removeBtn = row.querySelector(".remove-destination");

        if (entry.to_entity_ref || entry.toEntityRef) {
          entitySelect.dataset.selected = entry.to_entity_ref || entry.toEntityRef || "";
        }
        if (entry.amount !== undefined && entry.amount !== null && entry.amount !== "") {
          amountInput.value = entry.amount;
        }

        setupEntitySelector({
          typeSelect,
          entitySelect,
          balanceHint,
          customerFilter,
          selectedValue: entitySelect.dataset.selected,
          onChange: () => {
            updateRemainingBalance();
            updateDestinationHint(balanceHint, entitySelect, amountInput);
          },
          allowOther: false
        });

        amountInput.addEventListener("input", () => {
          updateRemainingBalance();
          updateDestinationHint(balanceHint, entitySelect, amountInput);
        });
        entitySelect.addEventListener("change", () => {
          updateRemainingBalance();
          updateDestinationHint(balanceHint, entitySelect, amountInput);
        });
        removeBtn?.addEventListener("click", () => {
          if (list.children.length <= 1) return;
          row.remove();
          updateRemainingBalance();
          toggleRemoveButtons();
        });

        list.appendChild(row);
        nextIndex += 1;
        toggleRemoveButtons();
        updateRemainingBalance();
        updateDestinationHint(balanceHint, entitySelect, amountInput);
      }

      function toggleRemoveButtons() {
        const rows = Array.from(list.querySelectorAll(".destination-row"));
        rows.forEach((row) => {
          const btn = row.querySelector(".remove-destination");
          if (!btn) return;
          const disabled = rows.length === 1;
          btn.disabled = disabled;
          btn.classList.toggle("disabled", disabled);
        });
      }
    }

    function initTransferForm() {
      const wrapper = document.querySelector("[data-transfer-form]");
      if (!wrapper || wrapper.dataset.inited === "true") return;
      wrapper.dataset.inited = "true";
      cashBoxBalance = wrapper.dataset.cashBoxBalance || "";

      const customerFilter = document.getElementById("customer_filter");
      const fromType = document.getElementById("from_type");
      fromSelect = document.getElementById("from_entity_ref");
      const fromHint = document.getElementById("from_balance_hint");
      destinationBlock = document.getElementById("destinations_block");
      const cashToggle = document.querySelector("[data-cash-box-toggle]");
      const cashInput = document.querySelector("[data-cash-box-input]");
      const fromOtherField = document.querySelector("[data-from-other-field]");
      const fromOtherInput = document.querySelector("[data-from-other-input]");
      const paymentSelect = document.querySelector("select[name='transfer[payment_method]']");

      setupEntitySelector({
        typeSelect: fromType,
        entitySelect: fromSelect,
        balanceHint: fromHint,
        customerFilter,
        selectedValue: fromSelect?.dataset.selected,
        onChange: updateRemainingBalance,
        allowOther: true
      });

      initDestinations(customerFilter);
      cashToggle?.addEventListener("change", updateRemainingBalance);
      cashInput?.addEventListener("input", updateRemainingBalance);
      const updateFromOtherField = () => {
        if (!fromOtherField || !fromOtherInput) return;
        const cashOk = cashToggle ? cashToggle.checked : true;
        const methodOk = paymentSelect ? paymentSelect.value === "efectivo" : true;
        const allowOther = cashOk && methodOk;
        const otherOption = fromType ? Array.from(fromType.options).find((opt) => opt.value === "Other") : null;
        if (otherOption) otherOption.disabled = !allowOther;
        if (!allowOther && fromType?.value === "Other") {
          fromType.value = "";
          if (fromSelect) fromSelect.value = "";
        }
        const isOther = fromType?.value === "Other";
        const shouldShow = isOther && allowOther;
        fromOtherField.hidden = !shouldShow;
        if (shouldShow) {
          fromOtherInput.setAttribute("required", "required");
          if (fromSelect) fromSelect.value = "Other";
        } else {
          fromOtherInput.removeAttribute("required");
          fromOtherInput.value = "";
        }
      };
      fromType?.addEventListener("change", updateFromOtherField);
      fromSelect?.addEventListener("change", updateFromOtherField);
      cashToggle?.addEventListener("change", updateFromOtherField);
      paymentSelect?.addEventListener("change", updateFromOtherField);
      updateRemainingBalance();
      updateFromOtherField();
    }

    document.addEventListener("turbo:load", initTransferForm);
    document.addEventListener("DOMContentLoaded", initTransferForm);
  })();
</script>
