<div class="page-header">
  <div>
    <h1>Transfer <%= @transfer.code %></h1>
    <p class="lead">Detalle del movimiento y relación con venta/origen/destino.</p>
  </div>
  <div class="transfer-actions">
    <%= link_to "Editar", edit_transfer_path(@transfer), class: "button button-secondary" %>
    <%= link_to "Eliminar", transfer_path(@transfer), class: "button button-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    <% if @sale %>
      <%= link_to "Volver a la venta", sale_transfers_path(@sale), class: "button button-ghost" %>
    <% else %>
      <%= link_to "Regresar", transfers_path, class: "button button-ghost" %>
    <% end %>
  </div>
</div>

<div class="transfer-detail-grid">
  <div class="transfer-detail">
    <span class="label">Origen</span>
    <span class="value"><%= @transfer.entity_label(:from) %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Destino</span>
    <span class="value"><%= @transfer.entity_label(:to) %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Venta</span>
    <span class="value"><%= @sale ? link_to(@sale.code, sale_path(@sale)) : "—" %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Fecha</span>
    <span class="value"><%= l(@transfer.occurred_at, format: :long) %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Proveedor</span>
    <span class="value"><%= @transfer.supplier&.name || "—" %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Método</span>
    <% pill_class = @transfer.payment_method == "efectivo" ? "payment-pill cash" : "payment-pill deposit" %>
    <% pill_label = @transfer.payment_method == "efectivo" ? "Efectivo" : "Depósito" %>
    <span class="value"><span class="<%= pill_class %>"><%= pill_label %></span></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Monto</span>
    <span class="value"><%= number_to_currency(@transfer.amount, unit: "$") %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Caja</span>
    <span class="value"><%= number_to_currency(@transfer.cash_box_amount.to_f, unit: "$") %></span>
  </div>
  <div class="transfer-detail">
    <span class="label">Nota</span>
    <span class="value"><%= @transfer.note.presence || "—" %></span>
  </div>
</div>
