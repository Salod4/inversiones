<h1>
  <% if @sale %>
    Transfers for Sale <%= @sale.code %>
  <% else %>
    Transfers
  <% end %>
</h1>

<div class="button-group">
  <% if @sale %>
    <%= link_to "New Transfer", new_sale_transfer_path(@sale), class: "button" %>
    <%= link_to "Back to Sale", sale_path(@sale), class: "button button-ghost" %>
  <% else %>
    <%= link_to "New Transfer", new_transfer_path, class: "button" %>
  <% end %>
</div>

<table>
  <thead>
    <tr>
      <th>Code</th>
      <th>Occurred At</th>
      <th>Supplier</th>
      <th>Customer</th>
      <th>Sale</th>
      <th>Amount</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @transfers.each do |transfer| %>
      <tr>
        <td><%= transfer.code %></td>
        <td><%= transfer.occurred_at %></td>
        <td><%= transfer.supplier&.name %></td>
        <td><%= transfer.customer&.name %></td>
        <td><%= transfer.sale&.code %></td>
        <td><%= transfer.amount %></td>
        <td>
          <%= link_to "Show", transfer_path(transfer), class: "button button-secondary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= pagination_nav(@pagy) %>
