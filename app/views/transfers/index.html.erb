<div class="transfers-page">
  <div class="page-header">
    <div>
      <h1>
        <% if @sale %>
          Transfers de la venta <%= @sale.code %>
        <% else %>
          Transfers
        <% end %>
      </h1>
      <p class="lead">Movimientos SPEI o efectivo entre clientes, grupos, proveedores y vendedores.</p>
    </div>
    <div class="transfer-actions">
      <% if @sale %>
        <%= link_to "Nuevo transfer", new_sale_transfer_path(@sale), class: "button" %>
        <%= link_to "Regresar a la venta", sale_path(@sale), class: "button button-ghost" %>
      <% else %>
        <%= link_to "Nuevo transfer", new_transfer_path, class: "button" %>
      <% end %>
    </div>
  </div>

  <div class="transfers-stats">
    <div class="transfer-stat">
      <span class="label">Total transfers</span>
      <span class="value"><%= @transfer_stats[:count] %></span>
    </div>
    <div class="transfer-stat">
      <span class="label">Monto total</span>
      <span class="value"><%= number_to_currency(@transfer_stats[:total_outgoing], unit: "$") %></span>
    </div>
    <div class="transfer-stat">
      <span class="label">Depósitos</span>
      <span class="value"><%= number_to_currency(@transfer_stats[:deposit_amount], unit: "$") %></span>
      <small class="muted"><%= @transfer_stats[:deposit_count] %> movimientos</small>
    </div>
    <div class="transfer-stat">
      <span class="label">Efectivo</span>
      <span class="value"><%= number_to_currency(@transfer_stats[:efectivo_amount], unit: "$") %></span>
      <small class="muted"><%= @transfer_stats[:efectivo_count] %> movimientos</small>
    </div>
  </div>

  <div class="card transfers-table">
    <div class="table-subtitle">Listado de transfers</div>
    <table>
      <thead>
        <tr>
          <th>Code</th>
          <th>Fecha</th>
          <th>Origen</th>
          <th>Destino</th>
          <th>Sale</th>
          <th>Método</th>
          <th>Monto</th>
          <th>Caja</th>
          <th class="actions-cell">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @transfers.any? %>
          <% @transfers.each do |transfer| %>
            <% pill_class = transfer.payment_method == "efectivo" ? "payment-pill cash" : "payment-pill deposit" %>
            <% pill_label = transfer.payment_method == "efectivo" ? "Efectivo" : "Depósito" %>
            <tr>
              <td><%= transfer.code %></td>
              <td><%= l(transfer.occurred_at, format: :short) %></td>
              <td><%= transfer.entity_label(:from) %></td>
              <td><%= transfer.entity_label(:to) %></td>
              <td><%= transfer.sale&.code || "—" %></td>
              <td><span class="<%= pill_class %>"><%= pill_label %></span></td>
              <td><%= number_to_currency(transfer.amount, unit: "$") %></td>
              <td><%= number_to_currency(transfer.cash_box_amount.to_f, unit: "$") %></td>
              <td class="actions-cell">
                <div class="actions-stack">
                  <%= link_to "Ver", transfer_path(transfer), class: "button button-secondary" %>
                  <%= link_to "Editar", edit_transfer_path(transfer), class: "button button-ghost" %>
                  <%= link_to "Eliminar", transfer_path(transfer), class: "button button-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8">No hay transfers registrados.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= pagination_nav(@pagy, item_name: "transfers") %>
  </div>
</div>
