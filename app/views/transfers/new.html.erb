<h1><%= @sale ? "New Transfer for Sale #{@sale.code}" : "New Transfer" %></h1>

<% if @sale %>
  <p class="hint">
    Saldo disponible en <strong><%= @sale.code %></strong>:
    <%= number_to_currency(@sale.available_transfer_amount, unit: "$") %>
  </p>
<% end %>

<%= render "form", transfer: @transfer, sale: @sale %>

<p>
  <% if @sale %>
    <%= link_to "Back", sale_transfers_path(@sale), class: "button button-ghost" %>
  <% else %>
    <%= link_to "Back", transfers_path, class: "button button-ghost" %>
  <% end %>
</p>
