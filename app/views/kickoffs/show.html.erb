<h1>Kickoff de saldos</h1>

<section class="card">
  <h2>Descargar plantillas (Excel)</h2>
  <div class="button-group">
    <%= link_to "Plantilla clientes/grupos", kickoff_template_path(type: :customers), class: "button button-secondary" %>
    <%= link_to "Plantilla proveedores", kickoff_template_path(type: :suppliers), class: "button button-secondary" %>
    <%= link_to "Plantilla vendedores", kickoff_template_path(type: :sellers), class: "button button-secondary" %>
  </div>
  <p class="hint">
    Clientes: ya incluye todos los clientes y los nombres de grupo (“GRUPO …”). Solo llena la columna de Total Cliente.
    Proveedores: columna "Saldo pendiente".
    Vendedores: columna "Total de comisión".
  </p>
</section>

<section class="card">
  <h2>Cargar archivos de kickoff</h2>
  <%= form_with url: kickoff_path, method: :post, multipart: true do |form| %>
    <div class="form-group">
      <%= form.label :customers_file, "Clientes / Grupos" %>
      <%= form.file_field :customers_file, accept: ".csv,.xlsx" %>
    </div>
    <div class="form-group">
      <%= form.label :suppliers_file, "Proveedores" %>
      <%= form.file_field :suppliers_file, accept: ".csv,.xlsx" %>
    </div>
    <div class="form-group">
      <%= form.label :sellers_file, "Vendedores" %>
      <%= form.file_field :sellers_file, accept: ".csv,.xlsx" %>
    </div>
    <div>
      <%= form.submit "Cargar kickoff", class: "button" %>
    </div>
  <% end %>
</section>
