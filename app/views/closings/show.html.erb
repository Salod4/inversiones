<div class="page-header">
  <div>
    <h1>Closing <%= @closing.business_date %></h1>
    <p class="lead">Estado del cierre y resumen financiero del día.</p>
  </div>
  <div class="button-group">
    <%= link_to "Edit", edit_closing_path(@closing), class: "button button-secondary" %>
    <%= link_to "Back", closings_path, class: "button button-ghost" %>
  </div>
</div>

<div class="closing-meta-grid">
  <div class="closing-meta">
    <span class="label">Status</span>
    <span class="value">
      <span class="status-pill <%= @closing.status == "closed" ? "status-closed" : "status-open" %>">
        <%= @closing.status&.capitalize || "Pendiente" %>
      </span>
    </span>
  </div>
  <div class="closing-meta">
    <span class="label">Closed At</span>
    <span class="value"><%= @closing.closed_at || "-" %></span>
  </div>
  <div class="closing-meta">
    <span class="label">Total Customers</span>
    <span class="value"><%= number_to_currency(@closing.total_customers, unit: "$") %></span>
  </div>
  <div class="closing-meta">
    <span class="label">Total Suppliers</span>
    <span class="value"><%= number_to_currency(@closing.total_suppliers, unit: "$") %></span>
  </div>
  <% diff_class = @closing.difference.to_d.negative? ? "difference-negative" : "difference-positive" %>
  <div class="closing-meta">
    <span class="label">Difference</span>
    <span class="value <%= diff_class %>"><%= number_to_currency(@closing.difference, unit: "$") %></span>
  </div>
</div>

<section>
  <h2>Group Closings</h2>

  <table>
    <thead>
      <tr>
        <th>Grupo</th>
        <th>Customer Balance</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @customer_group_totals.each do |row| %>
        <% zero_balance = row[:balance].to_d.zero? %>
        <tr class="<%= zero_balance ? "muted-row" : "" %>">
          <td><%= row[:name] %></td>
          <td class="<%= zero_balance ? "" : "difference-positive" %>"><%= number_to_currency(row[:balance], unit: "$") %></td>
          <td>
             <%= link_to "Ver grupo",
                  group_closing_customer_closings_path(@closing, name: row[:name]),
                  class: "button button-secondary" %>
             <%= link_to "Archivo grupo",
                  customer_group_pdf_closing_path(@closing, group_name: row[:name]),
                  class: "button button-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section>
  <h2>Customer Closings</h2>

  <% if @customer_rows.any? %>
    <table>
      <thead>
        <tr>
          <th>Cliente</th>
          <th>Balance</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @customer_rows.each do |row| %>
          <% cc = row[:customer_closing] %>
          <tr>
            <td><%= row[:customer_name] %></td>
            <td><%= number_to_currency(row[:balance], unit: "$") %></td>
            <td>
              <% if cc.present? %>
                <%= link_to "Ver cierre",
                            closing_customer_closing_path(@closing, cc),
                            class: "button button-secondary" %>
                <%= link_to "Editar",
                            edit_closing_customer_closing_path(@closing, cc),
                            class: "button button-ghost" %>
                <%= link_to "Archivo",
                            pdf_closing_customer_closing_path(@closing, cc),
                            class: "button button-secondary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No customer closings recorded.</p>
  <% end %>
</section>

<section>
  <h2>Proveedor Cierres</h2>

  <% if @supplier_closings.any? %>
    <table>
      <thead>
        <tr>
          <th>Supplier</th>
          <th>Depositado a Proveedor</th>
          <th>Total de proveedor</th>
          
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @supplier_closings.each do |supplier_closing| %>
          <tr>
            <td><%= supplier_closing.supplier&.name %></td>
            <td><%= supplier_closing.supplier_credit %></td>
            <td><%= supplier_closing.amount_owed_to_supplier %></td>
            <td>
              <%= link_to "Show", closing_supplier_closing_path(@closing, supplier_closing), class: "button button-secondary" %>
              <%= link_to "Edit", edit_closing_supplier_closing_path(@closing, supplier_closing), class: "button button-ghost" %>
              <%= link_to "Archivo",
                          pdf_closing_supplier_closing_path(@closing, supplier_closing),
                          class: "button button-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No supplier closings recorded.</p>
  <% end %>
</section>

<section>
  <h2>Transfers del día</h2>
  <% if @closing_transfers.any? %>
    <table>
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Código</th>
          <th>Origen</th>
          <th>Destino</th>
          <th>Monto</th>
          <th>Venta</th>
        </tr>
      </thead>
      <tbody>
        <% @closing_transfers.each do |transfer| %>
          <tr id="<%= dom_id(transfer) %>">
            <td><%= l(transfer.occurred_at, format: :short) %></td>
            <td><%= transfer.code %></td>
            <td><%= [transfer.from_entity_type, transfer.from_entity_id].join(" ") %></td>
            <td><%= [transfer.to_entity_type, transfer.to_entity_id].join(" ") %></td>
            <td><%= number_to_currency(transfer.amount, unit: "$") %></td>
            <td><%= link_to transfer.sale&.code, transfer.sale if transfer.sale.present? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No hubo transfers en este día.</p>
  <% end %>
</section>

<div class="button-group">
  <%= link_to "Edit", edit_closing_path(@closing), class: "button" %>
  <%= link_to "Back", closings_path, class: "button button-ghost" %>
</div>
