<h1>Closings</h1>

<p><%= link_to "New Closing", new_closing_path, class: "button" %></p>

<table>
  <thead>
    <tr>
      <th>Business Date</th>
      <th>Status</th>
      <th>Total Customers</th>
      <th>Total Suppliers</th>
      <th>Difference</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @closings.each do |closing| %>
      <tr>
        <td><%= closing.business_date %></td>
        <td><%= closing.status %></td>
        <td><%= closing.total_customers %></td>
        <td><%= closing.total_suppliers %></td>
        <td><%= closing.difference %></td>
        <td>
          <div class="button-group">
            <%= link_to "Show", closing, class: "button button-secondary" %>
            <%= link_to "Edit", edit_closing_path(closing), class: "button button-secondary" %>
            <%= link_to "Destroy", closing, class: "button button-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= pagination_nav(@pagy) %>
