<h1>Sales</h1>

<p><%= link_to "New Sale", new_sale_path, class: "button" %></p>
 <% if @closing_today_exists %>
    <span class="px-3 py-1 rounded bg-green-100 text-green-700 text-sm">
      Cierre de hoy ya realizado
    </span>
  <% else %>
    <%= button_to "Cerrar ventas de hoy",
                  close_today_sales_path,
                  method: :post,
                  data: { turbo: false, confirm: "¿Seguro que deseas cerrar las ventas de HOY?" },
                  class: "px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700" %>
  <% end %>

<table>
  <thead>
    <tr>
      <th>Codigo</th>
      <th>Fecha</th>
      <th>Cliente</th>
      <th>Proveedor</th>
      <th>Deposito bruto</th>
      <th>Commision proveedor</th>
      <th>SPEIS aplicados</th>
      <th>Ret. Cliente</th>
      <th>Balance de Cliente</th>
      <th>Ret. Comp</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @sales.each do |sale| %>
      <tr>
        <td><%= sale.code %></td>
        <td><%= sale.date %></td>
        <td><%= sale.customer&.name %></td>
        <td><%= sale.supplier&.name %></td>
        <td><%= sale.gross_deposit %></td>
        <td><%= sale.provider_commission %></td>
        <td><%= sale.total_transfer_applied %></td>
        <td><%= sale.working_capital %></td>
        <td><%= sale.customer_balance %></td>
        <td><%= sale.ret_comp %></td>
        <td><%= sale.status %></td>
        
        <td>
          <div class="button-group">
            <%= link_to "Show", sale, class: "button button-secondary" %>
            <%= link_to "Edit", edit_sale_path(sale), class: "button button-secondary" %>
            <%= link_to "Destroy", sale, class: "button button-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= pagination_nav(@pagy) %>
