<%= form_with(model: sale) do |f| %>
  <% if sale.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(sale.errors.count, "error") %> prevented this sale from being saved:</h2>
      <ul>
        <% sale.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :code %>
    <%= f.text_field :code %>
  </div>

  <div>
    <%= f.label :date %>
    <%= f.date_field :date %>
  </div>

  <div>
    <%= f.label :customer_id, "Customer" %>
    <%= f.collection_select :customer_id, @customers || Customer.order(:name), :id, :name, {}, { id: "sale_customer_id" } %>
  </div>

  <div>
    <%= f.label :supplier_id, "Supplier" %>
    <%= f.collection_select :supplier_id, @suppliers || Supplier.order(:name), :id, :name, {}, { id: "sale_supplier_id" } %>
  </div>

  <div>
    <%= f.label :closing_id, "Closing" %>
    <%= f.collection_select :closing_id, @closings || Closing.order(business_date: :desc), :id, :business_date, { include_blank: true }, { id: "sale_closing_id" } %>
  </div>

  <div>
    <label>Proveedor % (preview)</label>
    <input type="number" step="0.0001" id="preview_provider_pct" value="<%= sale.provider_pct %>" readonly>
  </div>

  <div>
    <label>Cliente % (preview)</label>
    <input type="number" step="0.0001" id="preview_customer_fee_pct" value="<%= sale.customer_fee_pct %>" readonly>
  </div>

  <div>
    <%= f.label :provider_pct_override, "Provider % override" %>
    <%= f.number_field :provider_pct_override, step: 0.0001 %>
  </div>

  <div>
    <%= f.label :customer_fee_pct_override, "Customer fee % override" %>
    <%= f.number_field :customer_fee_pct_override, step: 0.0001 %>
  </div>

  <div>
    <%= f.label :gross_deposit %>
    <%= f.number_field :gross_deposit, step: 0.01 %>
  </div>

  <div>
    <%= f.label :net_base %>
    <%= f.number_field :net_base, step: 0.01 %>
  </div>

  <div>
    <%= f.label :status %>
    <%= f.select :status, options_for_select([["Open", "open"], ["Closed", "closed"], ["Canceled", "canceled"]], sale.status), include_blank: true %>
  </div>

  <div id="preview_sales_users">
    <% sale.sales_users.each do |su| %>
      <div data-user-id="<%= su.user_id %>">
        <span>Vendedor #<%= su.user_id %></span>
        <input type="number" step="0.0001" name="sale[sales_users_attributes][][commission_pct_override]" placeholder="override opcional">
        <input type="hidden" name="sale[sales_users_attributes][][user_id]" value="<%= su.user_id %>">
        <small>default: <%= su.commission_pct %></small>
      </div>
    <% end %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
